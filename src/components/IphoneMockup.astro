---
interface Props {
  label?: string;
}

const { label } = Astro.props;
---

<div class="iphone-wrapper">
  <div class="iphone-shell">
    <div class="iphone-dynamic-island"></div>
    <div class="iphone-screen">
      <slot />
    </div>
    <div class="iphone-home-indicator"></div>
  </div>
  {label && <p class="iphone-label">{label}</p>}
</div>

<style>
  .iphone-wrapper {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .iphone-shell {
    width: 200px;
    height: 390px;
    border-radius: 44px;
    border: 8px solid #333;
    background: #000;
    position: relative;
    overflow: hidden;
    box-shadow:
      0 0 0 2px #555,
      0 20px 60px rgba(0, 0, 0, 0.5);
    flex-shrink: 0;
  }

  .iphone-dynamic-island {
    width: 80px;
    height: 22px;
    border-radius: 20px;
    background: #000;
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    border: 2px solid #1a1a1a;
  }

  .iphone-screen {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #111;
  }

  .iphone-home-indicator {
    width: 100px;
    height: 4px;
    border-radius: 4px;
    background: #555;
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
  }

  .iphone-label {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
    text-align: center;
    font-family: 'SF Mono', 'Fira Code', monospace;
    max-width: 200px;
    line-height: 1.4;
  }
</style>
