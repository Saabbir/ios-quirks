---
import { formatPublished, type Article } from '../data/articles';
import { withBase } from '../utils';

interface Props {
  article: Article;
  isNew?: boolean;
}

const { article, isNew = false } = Astro.props;
const searchText = `${article.title} ${article.description} ${article.slug} ${article.browser}`.toLowerCase();
---

<a
  href={withBase(`articles/${article.slug}`)}
  class="article-card"
  data-article-card
  data-search={searchText}
>
  <div class="card-top">
    <div class="card-emoji">{article.emoji}</div>
    {isNew && <span class="card-new">New</span>}
  </div>
  <h3 class="card-title">{article.title}</h3>
  <p class="card-desc">{article.description}</p>
  <div class="card-footer">
    <div class="card-footer-meta">
      <time class="card-date" datetime={article.published}>{formatPublished(article.published)}</time>
      <span class={`card-badge ${article.browser === 'iOS Safari' ? 'card-badge--safari' : 'card-badge--all'}`}>{article.browser}</span>
    </div>
    <svg class="card-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
      <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
</a>

<style>
  .article-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.4rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
  }
  .article-card[hidden] {
    display: none;
  }
  .article-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(10,132,255,0.04) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .article-card:hover {
    border-color: rgba(10, 132, 255, 0.4);
    transform: translateY(-1px);
    text-decoration: none;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }
  .article-card:hover::before {
    opacity: 1;
  }
  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .card-emoji {
    font-size: 1.75rem;
    line-height: 1;
    margin-bottom: 0.2rem;
  }
  .card-new {
    font-size: 0.68rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 20px;
    font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', 'Consolas', monospace;
    white-space: nowrap;
    color: var(--accent);
    background: rgba(10, 132, 255, 0.12);
    border: 1px solid rgba(10, 132, 255, 0.2);
    flex-shrink: 0;
  }
  .card-title {
    font-size: 0.97rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.3;
    margin: 0;
  }
  .card-desc {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.5;
    flex: 1;
  }
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  .card-footer-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    flex-wrap: wrap;
  }
  .card-date {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--muted);
    font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', 'Consolas', monospace;
    white-space: nowrap;
  }
  .card-badge {
    font-size: 0.68rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 20px;
    font-family: 'SF Mono', 'Fira Code', monospace;
    border: 1px solid;
    white-space: nowrap;
  }
  .card-badge--safari {
    color: var(--accent);
    background: rgba(10, 132, 255, 0.12);
    border-color: rgba(10, 132, 255, 0.2);
  }
  .card-badge--all {
    color: var(--success);
    background: rgba(48, 209, 88, 0.1);
    border-color: rgba(48, 209, 88, 0.2);
  }
  .card-arrow {
    color: var(--muted);
    flex-shrink: 0;
    transition: transform 0.15s, color 0.15s;
  }
  .article-card:hover .card-arrow {
    transform: translateX(3px);
    color: var(--accent);
  }
</style>
