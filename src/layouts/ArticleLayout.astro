---
import BaseLayout from './BaseLayout.astro';
import { getAdjacentArticles } from '../data/articles';
import { withBase } from '../utils';

interface Props {
  title: string;
  summary: string;
  affectedSince: string;
  slug: string;
}

const { title, summary, affectedSince, slug } = Astro.props;
const { prev, next } = getAdjacentArticles(slug);
---

<BaseLayout title={`${title} — iOS Quirks`} description={summary}>
  <style>
    .article-hero {
      border-bottom: 1px solid var(--border);
      padding: 3.5rem 1.5rem 3rem;
      background: linear-gradient(180deg, rgba(10,132,255,0.04) 0%, transparent 100%);
    }
    .article-hero-inner {
      max-width: 72ch;
      margin: 0 auto;
    }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: var(--muted);
      font-size: 0.85rem;
      margin-bottom: 2rem;
      transition: color 0.15s;
    }
    .back-link:hover { color: var(--accent); text-decoration: none; }
    .back-link svg { flex-shrink: 0; }
    .article-title {
      font-size: clamp(1.6rem, 4vw, 2.4rem);
      margin-bottom: 0.75rem;
      letter-spacing: -0.02em;
    }
    .article-title code {
      font-size: 0.85em;
      background: rgba(255,255,255,0.07);
      padding: 0.1em 0.3em;
      border-radius: 4px;
      font-family: 'SF Mono', 'Fira Code', monospace;
    }
    .article-summary {
      font-size: 1.05rem;
      color: #bbb;
      margin-bottom: 1.25rem;
      line-height: 1.65;
    }
    .affected-badge {
      display: inline-flex;
      align-items: flex-start;
      gap: 0.5rem;
      background: rgba(255, 69, 58, 0.12);
      border: 1px solid rgba(255, 69, 58, 0.25);
      color: #ff6b63;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 5px 10px;
      border-radius: 8px;
      font-family: 'SF Mono', 'Fira Code', monospace;
      line-height: 1.5;
      max-width: 100%;
    }
    .affected-badge::before {
      content: '';
      width: 6px;
      height: 6px;
      background: #ff453a;
      border-radius: 50%;
      flex-shrink: 0;
      margin-top: 0.35em;
    }
    .article-body {
      max-width: 72ch;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 4rem;
    }
    .article-body :global(h2) {
      font-size: 1.25rem;
      margin-top: 2.5rem;
      margin-bottom: 0.75rem;
      color: #fff;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--border);
    }
    .article-body :global(h3) {
      font-size: 1.05rem;
      margin-top: 1.75rem;
      margin-bottom: 0.5rem;
      color: #ddd;
    }
    .article-body :global(p) {
      color: #ccc;
      line-height: 1.75;
      margin-bottom: 1rem;
    }
    .article-body :global(ul), .article-body :global(ol) {
      color: #ccc;
      padding-left: 1.5rem;
      line-height: 1.75;
    }
    .article-body :global(.resource-list) {
      padding-left: 0;
    }
    .article-body :global(li) {
      margin-bottom: 0.4rem;
    }
    .article-body :global(strong) {
      color: #fff;
    }
    .article-body :global(code) {
      font-family: 'SF Mono', 'Fira Code', monospace;
      font-size: 0.85em;
      background: rgba(255,255,255,0.07);
      padding: 0.15em 0.4em;
      border-radius: 4px;
    }
    .article-body :global(pre code) {
      background: none;
      padding: 0;
      font-size: inherit;
    }
    .article-pager-wrap {
      border-top: 1px solid var(--border);
    }
    .article-pager {
      max-width: 72ch;
      margin: 0 auto;
      padding: 1.5rem 1.5rem 4rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    .pager-link {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1rem 1.2rem;
      text-decoration: none;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      min-width: 0;
      transition: border-color 0.15s, transform 0.15s;
    }
    .pager-link:hover {
      border-color: rgba(10, 132, 255, 0.4);
      text-decoration: none;
      transform: translateY(-1px);
    }
    .pager-link--next .pager-label {
      align-self: flex-end;
    }
    .pager-link--placeholder {
      visibility: hidden;
      pointer-events: none;
    }
    .pager-label {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--muted);
      font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', 'Consolas', monospace;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .pager-label svg {
      flex-shrink: 0;
    }
    .pager-title {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text);
      line-height: 1.3;
    }
    .pager-link:hover .pager-title {
      color: var(--accent);
    }
    .pager-link:hover .pager-label {
      color: var(--accent);
    }
    @media (max-width: 560px) {
      .article-pager {
        grid-template-columns: 1fr;
      }
      .pager-link--next .pager-label {
        align-self: flex-start;
      }
      .pager-link--placeholder {
        display: none;
      }
    }
  </style>

  <div class="article-hero">
    <div class="article-hero-inner">
      <a href={withBase()} class="back-link">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M9 2L4 7L9 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        All articles
      </a>
      <h1 class="article-title">{title}</h1>
      <p class="article-summary">{summary}</p>
      <span class="affected-badge">{affectedSince}</span>
    </div>
  </div>

  <div class="article-body">
    <slot />
  </div>

  <div class="article-pager-wrap">
    <nav class="article-pager" aria-label="Article pagination">
      {prev ? (
        <a href={withBase(`articles/${prev.slug}`)} class="pager-link pager-link--prev">
          <span class="pager-label">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M9 2L4 7L9 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Previous
          </span>
          <span class="pager-title">{prev.emoji} {prev.title}</span>
        </a>
      ) : (
        <span class="pager-link pager-link--placeholder" />
      )}
      {next ? (
        <a href={withBase(`articles/${next.slug}`)} class="pager-link pager-link--next">
          <span class="pager-label">
            Next
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M5 2L10 7L5 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="pager-title">{next.emoji} {next.title}</span>
        </a>
      ) : (
        <span class="pager-link pager-link--placeholder" />
      )}
    </nav>
  </div>
</BaseLayout>
