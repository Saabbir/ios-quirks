---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles } from '../data/articles';

const newestPublished = articles[0]?.published;
const recentArticles = articles.slice(0, 3);
---

<BaseLayout title="iOS Quirks — Developer Reference">
  <style>
    .hero {
      padding: 5rem 1.5rem 4rem;
      text-align: center;
      border-bottom: 1px solid var(--border);
      background: radial-gradient(ellipse 60% 40% at 50% 0%, rgba(10,132,255,0.08) 0%, transparent 70%);
    }
    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 1.25rem;
      font-family: 'SF Mono', 'Fira Code', monospace;
    }
    .hero-eyebrow-dot {
      width: 6px;
      height: 6px;
      background: var(--accent);
      border-radius: 50%;
      flex-shrink: 0;
      animation: pulse 2s ease-in-out infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }
    .hero-title {
      font-size: clamp(2.2rem, 6vw, 3.8rem);
      letter-spacing: -0.03em;
      margin-bottom: 1rem;
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
      line-height: 1.1;
    }
    .hero-title span {
      background: linear-gradient(135deg, var(--accent) 0%, #64b5ff 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .hero-subtitle {
      font-size: 1.1rem;
      color: #999;
      max-width: 520px;
      margin: 0 auto 2.5rem;
      line-height: 1.65;
    }
    .hero-stats {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 2rem;
      flex-wrap: wrap;
    }
    .hero-stat {
      text-align: center;
    }
    .hero-stat-num {
      display: block;
      font-size: 1.5rem;
      font-weight: 800;
      color: #fff;
      letter-spacing: -0.02em;
    }
    .hero-stat-label {
      font-size: 0.75rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .hero-stat-divider {
      width: 1px;
      height: 30px;
      background: var(--border);
    }
    .home-main {
      max-width: 1100px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 3rem;
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
    }
    .section-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.25rem;
    }
    .section-title {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
      margin: 0;
      white-space: nowrap;
    }
    .section-line {
      flex: 1;
      height: 1px;
      background: var(--border);
    }
    .articles-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1rem;
    }
  </style>

  <section class="hero">
    <div class="hero-eyebrow">
      <span class="hero-eyebrow-dot"></span>
      Developer Reference
    </div>
    <h1 class="hero-title">
      <span>iOS</span> Quirks
    </h1>
    <p class="hero-subtitle">
      Common iOS browser bugs explained with visuals and copy-paste fixes. Affects Safari, Chrome, and every browser on iOS.
    </p>
    <div class="hero-stats">
      <div class="hero-stat">
        <span class="hero-stat-num">{articles.length}</span>
        <span class="hero-stat-label">Articles</span>
      </div>
      <div class="hero-stat-divider"></div>
      <div class="hero-stat">
        <span class="hero-stat-num">CSS</span>
        <span class="hero-stat-label">Focus</span>
      </div>
      <div class="hero-stat-divider"></div>
      <div class="hero-stat">
        <span class="hero-stat-num">∞</span>
        <span class="hero-stat-label">Hours saved</span>
      </div>
    </div>
  </section>

  <div class="home-main">
    <section id="recent-articles">
      <div class="section-header">
        <h2 class="section-title">Recent</h2>
        <div class="section-line"></div>
      </div>
      <div class="articles-grid">
        {recentArticles.map((article) => (
          <ArticleCard article={article} isNew={article.published === newestPublished} />
        ))}
      </div>
    </section>

    <section id="all-articles">
      <div class="section-header">
        <h2 class="section-title">All articles</h2>
        <div class="section-line"></div>
      </div>
      <div class="articles-grid">
        {articles.map((article) => (
          <ArticleCard article={article} isNew={article.published === newestPublished} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
